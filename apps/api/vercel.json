{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/dist/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/api/dist/index.js"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/eta",
      "schedule": "* * * * *"
    }
  ]
}
